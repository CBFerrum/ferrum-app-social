{
  "base": "https://mastodon.example",
  "auth": {
    "type": "oauth",
    "owner": "workspace",
    "provider": {
      "authorize_url": "https://mastodon.example/oauth/authorize",
      "token_url": "https://mastodon.example/oauth/token",
      "revoke_url": "https://mastodon.example/oauth/revoke",
      "scopes": [
        "read",
        "write"
      ],
      "client_id": "REPLACE-WITH-THE-APPS-CLIENT-ID",
      "client_secret": "client_secret",
      "client_auth": "body"
    }
  },
  "apps": [
    "social"
  ],
  "meta": {
    "carries": {
      "network": "Mastodon",
      "provider": "mastodon",
      "server": "instance",
      "placeholder": "https://mastodon.example"
    },
    "capabilities": {
      "name": "Mastodon",
      "max_text": 500,
      "images": true,
      "max_media": 4,
      "alt_text": true,
      "first_comment": true,
      "html_text": true
    }
  },
  "operations": {
    "publish": {
      "method": "POST",
      "path": "/api/v1/statuses",
      "body": "{\"status\": {{ inputs.text_with_link | json }}, \"media_ids\": {{ inputs.media | json }}}",
      "result": {
        "id": "/id",
        "url": "/url"
      },
      "error_at": "/error",
      "idempotency_header": "Idempotency-Key",
      "inputs": [
        "text_with_link",
        "media"
      ]
    },
    "publish_media": {
      "method": "POST",
      "path": "/api/v2/media",
      "form": {
        "file": {
          "file": "{{ inputs.file }}",
          "name": "{{ inputs.name }}"
        },
        "description": "{{ inputs.alt }}"
      },
      "result": {
        "id": "/id"
      },
      "error_at": "/error",
      "inputs": [
        "file",
        "name",
        "alt"
      ],
      "idempotency_header": "Idempotency-Key"
    },
    "delete": {
      "method": "DELETE",
      "path": "/api/v1/statuses/{{ inputs.id }}",
      "error_at": "/error",
      "inputs": [
        "id"
      ],
      "idempotency_header": "Idempotency-Key"
    },
    "reply": {
      "method": "POST",
      "path": "/api/v1/statuses",
      "body": "{\"status\": {% if inputs.author and ('@' ~ inputs.author) not in inputs.text %}{{ ('@' ~ inputs.author ~ ' ' ~ inputs.text) | json }}{% else %}{{ inputs.text | json }}{% endif %}, \"in_reply_to_id\": {{ inputs.in_reply_to | json }}{% if inputs.thread %}, \"visibility\": {{ inputs.thread | json }}{% endif %}}",
      "result": {
        "id": "/id"
      },
      "error_at": "/error",
      "idempotency_header": "Idempotency-Key",
      "inputs": [
        "text",
        "in_reply_to",
        "author",
        "thread"
      ]
    },
    "send_message": {
      "method": "POST",
      "path": "/api/v1/statuses",
      "body": "{\"status\": {{ ('@' ~ inputs.author ~ ' ' ~ inputs.text) | json }}, \"visibility\": \"direct\", \"in_reply_to_id\": {{ inputs.in_reply_to | json }}}",
      "result": {
        "id": "/id"
      },
      "error_at": "/error",
      "idempotency_header": "Idempotency-Key",
      "inputs": [
        "text",
        "in_reply_to",
        "author"
      ]
    },
    "metrics": {
      "path": "/api/v1/statuses/{{ inputs.id }}",
      "result": {
        "engagements": {
          "expr": "answer.favourites_count + answer.reblogs_count + answer.replies_count"
        }
      },
      "error_at": "/error",
      "inputs": [
        "id"
      ]
    },
    "account": {
      "path": "/api/v1/accounts/verify_credentials",
      "result": {
        "followers": "/followers_count"
      },
      "error_at": "/error"
    },
    "messages": {
      "path": "/api/v1/notifications",
      "query": {
        "types[]": "mention",
        "limit": "40"
      },
      "error_at": "/error"
    }
  },
  "pulls": [
    {
      "name": "mentions",
      "operation": "messages",
      "every_minutes": 15,
      "items_at": "",
      "cursor": "token",
      "next_at": {
        "link": "prev"
      },
      "max_pages": 3,
      "map": {
        "entity": "SocialMessage",
        "outside": true,
        "by": {
          "external_id": "/status/id"
        },
        "set": {
          "kind": "item.status.visibility == 'direct' ? 'Direct' : 'Mention'",
          "author": "/account/acct",
          "author_id": "/account/id",
          "text": "/status/content",
          "thread": "/status/visibility",
          "post_external_id": "/status/in_reply_to_id",
          "via_connection": "connection.id"
        }
      }
    }
  ]
}
