{
  "base": "https://api.telegram.org",
  "auth": {
    "type": "none"
  },
  "apps": [
    "social"
  ],
  "allowed_hosts": [
    "api.telegram.org"
  ],
  "timeout_ms": 60000,
  "limit": {
    "per": 30,
    "every": 1,
    "concurrent": 2
  },
  "meta": {
    "label": "Telegram (a bot in a chat)",
    "carries": {
      "network": "Telegram",
      "provider": "telegram"
    },
    "social": {
      "name": "Telegram",
      "text": {
        "max": 4096,
        "count": "characters",
        "format": "html"
      },
      "media": {
        "kinds": [
          "image",
          "video",
          "document",
          "file"
        ],
        "max": 10,
        "mixes": [
          {
            "image": 10,
            "video": 10
          },
          {
            "document": 10
          },
          {
            "file": 10
          }
        ],
        "image": {
          "max_bytes": 10485760
        },
        "video": {
          "max_bytes": 26214400
        },
        "document": {
          "max_bytes": 26214400
        },
        "other": {
          "file": {
            "max_bytes": 26214400
          }
        }
      },
      "kinds": [
        {
          "name": "message",
          "label": "Message",
          "media": {
            "kinds": []
          }
        },
        {
          "name": "media",
          "label": "Photos, video or files",
          "text": {
            "max": 1024,
            "count": "characters",
            "format": "html"
          },
          "media": {
            "kinds": [
              "image",
              "video",
              "document",
              "file"
            ],
            "max": 10,
            "mixes": [
              {
                "image": 10,
                "video": 10
              },
              {
                "document": 10
              },
              {
                "file": 10
              }
            ],
            "image": {
              "max_bytes": 10485760
            },
            "video": {
              "max_bytes": 26214400
            },
            "document": {
              "max_bytes": 26214400
            },
            "other": {
              "file": {
                "max_bytes": 26214400
              }
            },
            "required": true,
            "min": 1
          }
        }
      ],
      "follow_ups": {
        "as": "thread",
        "media": false,
        "max": 20
      },
      "link_preview": true,
      "accounts": {
        "operation": "accounts",
        "items_at": "/result",
        "value_at": "/my_chat_member/chat/id",
        "label_at": "/my_chat_member/chat/title",
        "handle_at": "/my_chat_member/chat/username",
        "kind_at": "/my_chat_member/chat/type"
      },
      "kind_by_media": {
        "none": "message",
        "image": "media",
        "video": "media",
        "document": "media"
      }
    }
  },
  "operations": {
    "get_me": {
      "url": "https://api.telegram.org/bot{{ secret.bot_token }}/getMe",
      "error_at": "/description",
      "temporary": [
        429,
        500,
        502,
        504
      ]
    },
    "accounts": {
      "url": "https://api.telegram.org/bot{{ secret.bot_token }}/getUpdates",
      "query": {
        "allowed_updates": "[\"my_chat_member\"]"
      },
      "error_at": "/description",
      "temporary": [
        429,
        500,
        502,
        504
      ]
    },
    "get_chat": {
      "url": "https://api.telegram.org/bot{{ secret.bot_token }}/getChat",
      "query": {
        "chat_id": "{{ inputs.chat_id }}"
      },
      "result": {
        "title": "/result/title",
        "username": "/result/username"
      },
      "error_at": "/description",
      "temporary": [
        429,
        500,
        502,
        504
      ],
      "inputs": [
        "chat_id"
      ]
    },
    "get_count": {
      "url": "https://api.telegram.org/bot{{ secret.bot_token }}/getChatMemberCount",
      "query": {
        "chat_id": "{{ inputs.chat_id }}"
      },
      "result": {
        "count": "/result"
      },
      "error_at": "/description",
      "temporary": [
        429,
        500,
        502,
        504
      ],
      "inputs": [
        "chat_id"
      ]
    },
    "account": {
      "inputs": [
        "account_id"
      ],
      "changes": false,
      "steps": [
        {
          "name": "chat",
          "operation": "get_chat",
          "inputs": {
            "chat_id": "inputs.account_id"
          }
        },
        {
          "name": "members",
          "operation": "get_count",
          "inputs": {
            "chat_id": "inputs.account_id"
          }
        }
      ],
      "result": {
        "name": "/chat/title",
        "handle": "/chat/username",
        "followers": "/members/count"
      }
    },
    "send_message": {
      "method": "POST",
      "url": "https://api.telegram.org/bot{{ secret.bot_token }}/sendMessage",
      "body": "{\"chat_id\": {{ inputs.chat_id | json }}, \"text\": {{ inputs.text | json }}, \"parse_mode\": \"HTML\"{% if inputs.reply_to %}, \"reply_parameters\": {\"message_id\": {{ inputs.reply_to | int | json }}, \"allow_sending_without_reply\": true}{% endif %}}",
      "result": {
        "message_id": "/result/message_id"
      },
      "error_at": "/description",
      "temporary": [
        429,
        500,
        502,
        504
      ],
      "inputs": [
        "chat_id",
        "text",
        "reply_to"
      ]
    },
    "send_photo": {
      "method": "POST",
      "url": "https://api.telegram.org/bot{{ secret.bot_token }}/sendPhoto",
      "form": {
        "chat_id": "{{ inputs.chat_id }}",
        "caption": "{{ inputs.caption }}",
        "parse_mode": "HTML",
        "photo": {
          "file": "{{ inputs.file }}",
          "max_bytes": 10485760
        }
      },
      "result": {
        "message_id": "/result/message_id"
      },
      "error_at": "/description",
      "temporary": [
        429,
        500,
        502,
        504
      ],
      "inputs": [
        "chat_id",
        "caption",
        "file"
      ]
    },
    "send_video": {
      "method": "POST",
      "url": "https://api.telegram.org/bot{{ secret.bot_token }}/sendVideo",
      "form": {
        "chat_id": "{{ inputs.chat_id }}",
        "caption": "{{ inputs.caption }}",
        "parse_mode": "HTML",
        "video": {
          "file": "{{ inputs.file }}",
          "max_bytes": 26214400
        },
        "supports_streaming": "true"
      },
      "result": {
        "message_id": "/result/message_id"
      },
      "error_at": "/description",
      "temporary": [
        429,
        500,
        502,
        504
      ],
      "inputs": [
        "chat_id",
        "caption",
        "file"
      ]
    },
    "send_document": {
      "method": "POST",
      "url": "https://api.telegram.org/bot{{ secret.bot_token }}/sendDocument",
      "form": {
        "chat_id": "{{ inputs.chat_id }}",
        "caption": "{{ inputs.caption }}",
        "parse_mode": "HTML",
        "document": {
          "file": "{{ inputs.file }}",
          "max_bytes": 26214400
        }
      },
      "result": {
        "message_id": "/result/message_id"
      },
      "error_at": "/description",
      "temporary": [
        429,
        500,
        502,
        504
      ],
      "inputs": [
        "chat_id",
        "caption",
        "file"
      ]
    },
    "delete": {
      "method": "POST",
      "url": "https://api.telegram.org/bot{{ secret.bot_token }}/deleteMessages",
      "body": "{\"chat_id\": {{ inputs.id | split(':') | first | json }}, \"message_ids\": {{ inputs.id | split(':') | last | split(',') | map('int') | list | json }}}",
      "error_at": "/description",
      "temporary": [
        429,
        500,
        502,
        504
      ],
      "inputs": [
        "id"
      ]
    },
    "send_album": {
      "method": "POST",
      "url": "https://api.telegram.org/bot{{ secret.bot_token }}/sendMediaGroup",
      "form": {
        "chat_id": "{{ inputs.chat_id }}",
        "media": "[{% for m in inputs.media_items %}{% if not loop.first %},{% endif %}{\"type\": {{ ('photo' if m.kind == 'image' else ('video' if m.kind == 'video' else 'document')) | json }}, \"media\": \"attach://f{{ loop.index0 }}\"{% if loop.first %}, \"caption\": {{ inputs.caption | json }}, \"parse_mode\": \"HTML\"{% endif %}}{% endfor %}]",
        "f{{ index }}": {
          "file": "{{ item.file }}",
          "each": "inputs.media_items",
          "max_bytes": 26214400
        }
      },
      "result": {
        "ids": {
          "expr": "answer.result.map(m, string(m.message_id))"
        }
      },
      "error_at": "/description",
      "temporary": [
        429,
        500,
        502,
        504
      ],
      "inputs": [
        "chat_id",
        "caption",
        "media_items"
      ]
    },
    "publish": {
      "inputs": [
        "account_id",
        "text_with_link",
        "media",
        "media_items",
        "reply_to"
      ],
      "steps": [
        {
          "name": "text",
          "operation": "send_message",
          "when": "not inputs.media_items",
          "inputs": {
            "chat_id": "inputs.account_id",
            "text": "inputs.text_with_link",
            "reply_to": "(inputs.reply_to | split(':') | last | split(',') | first) if inputs.reply_to else none"
          }
        },
        {
          "name": "photo",
          "operation": "send_photo",
          "when": "inputs.media_items | length == 1 and inputs.media_items[0].kind == 'image'",
          "inputs": {
            "chat_id": "inputs.account_id",
            "file": "inputs.media_items[0].file",
            "caption": "inputs.text_with_link"
          }
        },
        {
          "name": "video",
          "operation": "send_video",
          "when": "inputs.media_items | length == 1 and inputs.media_items[0].kind == 'video'",
          "inputs": {
            "chat_id": "inputs.account_id",
            "file": "inputs.media_items[0].file",
            "caption": "inputs.text_with_link"
          }
        },
        {
          "name": "document",
          "operation": "send_document",
          "when": "inputs.media_items | length == 1 and inputs.media_items[0].kind in ['document', 'file']",
          "inputs": {
            "chat_id": "inputs.account_id",
            "file": "inputs.media_items[0].file",
            "caption": "inputs.text_with_link"
          }
        },
        {
          "name": "album",
          "operation": "send_album",
          "when": "inputs.media_items | length > 1",
          "inputs": {
            "chat_id": "inputs.account_id",
            "caption": "inputs.text_with_link",
            "media_items": "inputs.media_items"
          }
        }
      ],
      "result": {
        "id": {
          "expr": "concat(inputs.account_id, ':', answer.text != null ? string(answer.text.message_id) : (answer.photo != null ? string(answer.photo.message_id) : (answer.video != null ? string(answer.video.message_id) : (answer.document != null ? string(answer.document.message_id) : answer.album.ids.join(',')))))"
        }
      }
    }
  }
}
