{
  "base": "https://api.x.com",
  "auth": {
    "type": "oauth",
    "owner": "workspace",
    "provider": {
      "authorize_url": "https://x.com/i/oauth2/authorize",
      "token_url": "https://api.x.com/2/oauth2/token",
      "revoke_url": "https://api.x.com/2/oauth2/revoke",
      "scopes": [
        "tweet.read",
        "tweet.write",
        "users.read",
        "media.write",
        "dm.read",
        "dm.write",
        "offline.access"
      ],
      "client_id": "REPLACE-WITH-THE-APPS-CLIENT-ID",
      "client_secret": "client_secret",
      "client_auth": "basic"
    }
  },
  "apps": [
    "social"
  ],
  "meta": {
    "capabilities": {
      "name": "X",
      "max_text": 280,
      "link_length": 23,
      "images": true,
      "max_media": 4,
      "max_image_bytes": 5000000,
      "alt_text": false,
      "first_comment": true
    }
  },
  "operations": {
    "publish": {
      "method": "POST",
      "path": "/2/tweets",
      "body": "{\"text\": {{ inputs.text_with_link | json }}{% if inputs.media %}, \"media\": {\"media_ids\": {{ inputs.media | json }}}{% endif %}}",
      "result": {
        "id": "/data/id"
      },
      "error_at": "/detail",
      "inputs": [
        "text_with_link",
        "media"
      ],
      "idempotency_header": "Idempotency-Key"
    },
    "publish_media": {
      "method": "POST",
      "path": "/2/media/upload",
      "form": {
        "media": {
          "file": "{{ inputs.file }}",
          "name": "{{ inputs.name }}",
          "max_bytes": 5000000
        },
        "media_category": "tweet_image"
      },
      "result": {
        "id": "/data/id"
      },
      "error_at": "/detail",
      "inputs": [
        "file",
        "name"
      ],
      "idempotency_header": "Idempotency-Key"
    },
    "delete": {
      "method": "DELETE",
      "path": "/2/tweets/{{ inputs.id }}",
      "error_at": "/detail",
      "inputs": [
        "id"
      ],
      "idempotency_header": "Idempotency-Key"
    },
    "reply": {
      "method": "POST",
      "path": "/2/tweets",
      "body": "{\"text\": {{ inputs.text | json }}, \"reply\": {\"in_reply_to_tweet_id\": {{ inputs.in_reply_to | json }}}}",
      "result": {
        "id": "/data/id"
      },
      "error_at": "/detail",
      "inputs": [
        "text",
        "in_reply_to"
      ],
      "idempotency_header": "Idempotency-Key"
    },
    "send_message": {
      "method": "POST",
      "path": "/2/dm_conversations/with/{{ inputs.to }}/messages",
      "body": "{\"text\": {{ inputs.text | json }}}",
      "result": {
        "id": "/data/dm_event_id"
      },
      "error_at": "/detail",
      "inputs": [
        "to",
        "text"
      ],
      "idempotency_header": "Idempotency-Key"
    },
    "metrics": {
      "path": "/2/tweets/{{ inputs.id }}",
      "query": {
        "tweet.fields": "public_metrics"
      },
      "result": {
        "impressions": "/data/public_metrics/impression_count",
        "engagements": {
          "expr": "answer.data.public_metrics.like_count + answer.data.public_metrics.retweet_count + answer.data.public_metrics.reply_count + answer.data.public_metrics.quote_count"
        }
      },
      "error_at": "/detail",
      "inputs": [
        "id"
      ]
    },
    "account": {
      "path": "/2/users/by/username/REPLACE-WITH-THE-HANDLE",
      "query": {
        "user.fields": "public_metrics"
      },
      "result": {
        "followers": "/data/public_metrics/followers_count"
      },
      "error_at": "/detail"
    },
    "messages": {
      "path": "/2/users/REPLACE-WITH-THE-USER-ID/mentions{% if cursor %}?since_id={{ cursor }}{% endif %}",
      "query": {
        "max_results": "50"
      },
      "error_at": "/detail"
    }
  },
  "pulls": [
    {
      "name": "mentions",
      "operation": "messages",
      "every_minutes": 15,
      "items_at": "/data",
      "cursor": "token",
      "next_at": "/meta/newest_id",
      "max_pages": 3,
      "map": {
        "entity": "SocialMessage",
        "outside": true,
        "by": {
          "external_id": "/id"
        },
        "set": {
          "kind": "'Mention'",
          "author": "/author_id",
          "author_id": "/author_id",
          "text": "/text",
          "thread": "/id",
          "via_connection": "connection.id"
        },
        "as": "system"
      }
    }
  ]
}
