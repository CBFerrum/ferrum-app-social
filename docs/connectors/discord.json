{
  "base": "https://discord.com/api/v10",
  "auth": {
    "type": "header",
    "header": "authorization",
    "secret": "bot_token",
    "prefix": "Bot "
  },
  "headers": {
    "user-agent": "DiscordBot (https://ferrum.example, 1.0)"
  },
  "apps": [
    "social"
  ],
  "allowed_hosts": [
    "discord.com"
  ],
  "timeout_ms": 60000,
  "limit": {
    "per": 50,
    "every": 1,
    "concurrent": 3
  },
  "meta": {
    "carries": {
      "network": "Discord",
      "provider": "discord"
    },
    "social": {
      "name": "Discord",
      "text": {
        "max": 2000,
        "count": "characters",
        "format": "markdown"
      },
      "media": {
        "kinds": [
          "image",
          "video",
          "document",
          "file"
        ],
        "max": 10,
        "alt": true,
        "alt_max": 1024,
        "image": {
          "max_bytes": 10485760
        },
        "video": {
          "max_bytes": 10485760
        },
        "document": {
          "max_bytes": 10485760
        },
        "other": {
          "file": {
            "max_bytes": 10485760
          }
        }
      },
      "kinds": [
        {
          "name": "message",
          "label": "Message"
        }
      ],
      "follow_ups": {
        "as": "thread",
        "media": true,
        "max": 20
      },
      "first_comment": true,
      "link_preview": true,
      "settings": [
        {
          "key": "channel",
          "label": "Channel",
          "type": "select",
          "required": true,
          "choices": {
            "operation": "channels",
            "inputs": {
              "guild": "account.id"
            },
            "items_at": "/channels",
            "value_at": "/id",
            "label_at": "/name"
          }
        }
      ],
      "accounts": {
        "operation": "accounts",
        "items_at": "/servers",
        "value_at": "/id",
        "label_at": "/name",
        "picture_at": "/picture"
      },
      "mentions": {
        "operation": "mentions",
        "inputs": {
          "guild": "account.id",
          "query": "query"
        },
        "items_at": "/people",
        "value_at": "/id",
        "label_at": "/name",
        "format": "<@{{ value }}>"
      }
    }
  },
  "operations": {
    "send_message": {
      "method": "POST",
      "path": "/channels/{{ inputs.channel_id }}/messages",
      "body": "{\"content\": {{ inputs.content | json }}, \"nonce\": {{ key | tid | json }}, \"enforce_nonce\": true, \"allowed_mentions\": {\"parse\": [\"users\"]}{% if inputs.reply_to %}, \"message_reference\": {\"message_id\": {{ inputs.reply_to | json }}, \"fail_if_not_exists\": false}{% endif %}}",
      "result": {
        "ref": {
          "expr": "concat(answer.channel_id, ':', answer.id)"
        }
      },
      "error_at": "/message",
      "temporary": [
        429,
        500,
        502,
        503,
        504
      ],
      "idempotency_header": "X-Idempotency-Key",
      "inputs": [
        "channel_id",
        "content",
        "reply_to"
      ]
    },
    "create_thread": {
      "method": "POST",
      "path": "/channels/{{ inputs.channel_id }}/messages/{{ inputs.message_id }}/threads",
      "body": "{\"name\": {{ inputs.name | json }}, \"auto_archive_duration\": 1440}",
      "result": {
        "id": "/id"
      },
      "error_at": "/message",
      "temporary": [
        429,
        500,
        502,
        503,
        504
      ],
      "inputs": [
        "channel_id",
        "message_id",
        "name"
      ]
    },
    "get_channel": {
      "path": "/channels/{{ inputs.channel_id }}",
      "result": {
        "id": "/id"
      },
      "error_at": "/message",
      "temporary": [
        429,
        500,
        502,
        503,
        504
      ],
      "inputs": [
        "channel_id"
      ]
    },
    "send_files_1": {
      "method": "POST",
      "path": "/channels/{{ inputs.channel_id }}/messages",
      "form": {
        "payload_json": "{\"content\": {{ inputs.content | json }}, \"nonce\": {{ key | tid | json }}, \"enforce_nonce\": true, \"allowed_mentions\": {\"parse\": [\"users\"]}, \"attachments\": [{\"id\": 0, \"description\": {{ inputs.a0 | json }}}]}",
        "files[0]": {
          "file": "{{ inputs.f0 }}",
          "max_bytes": 10485760
        }
      },
      "result": {
        "ref": {
          "expr": "concat(answer.channel_id, ':', answer.id)"
        }
      },
      "error_at": "/message",
      "temporary": [
        429,
        500,
