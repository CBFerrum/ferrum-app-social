        "id": {
          "expr": "inputs.file"
        }
      }
    },
    "me": {
      "path": "/users/@me",
      "error_at": "/message",
      "temporary": [
        429,
        500,
        502,
        503,
        504
      ]
    },
    "delete": {
      "method": "DELETE",
      "path": "/channels/{{ inputs.id | split(':') | first }}/messages/{{ inputs.id | split(':') | last }}",
      "error_at": "/message",
      "temporary": [
        429,
        500,
        502,
        503,
        504
      ],
      "inputs": [
        "id"
      ]
    },
    "reply": {
      "method": "POST",
      "path": "/channels/{{ inputs.in_reply_to | split(':') | first }}/messages",
      "body": "{\"content\": {{ inputs.text | json }}, \"nonce\": {{ key | tid | json }}, \"enforce_nonce\": true, \"allowed_mentions\": {\"parse\": [\"users\"]}, \"message_reference\": {\"message_id\": {{ inputs.in_reply_to | split(':') | last | json }}, \"fail_if_not_exists\": false}}",
      "result": {
        "id": {
          "expr": "concat(answer.channel_id, ':', answer.id)"
        }
      },
      "error_at": "/message",
      "temporary": [
        429,
        500,
        502,
        503,
        504
      ],
      "idempotency_header": "X-Idempotency-Key",
      "inputs": [
        "text",
        "in_reply_to"
      ]
    },
    "accounts": {
      "path": "/users/@me/guilds",
      "changes": false,
      "result": {
        "servers": {
          "expr": "answer.map(g, {'id': g.id, 'name': g.name, 'picture': g.icon != null ? 'https://cdn.discordapp.com/icons/' + g.id + '/' + g.icon + '.png' : null})"
        }
      },
      "error_at": "/message",
      "temporary": [
