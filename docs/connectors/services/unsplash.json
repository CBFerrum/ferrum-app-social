{
  "base": "https://api.unsplash.com",
  "auth": {
    "type": "none"
  },
  "apps": [
    "social"
  ],
  "allowed_hosts": [
    "api.unsplash.com",
    "images.unsplash.com"
  ],
  "headers": {
    "Authorization": "Client-ID {{ secret.access_key }}",
    "Accept-Version": "v1"
  },
  "operations": {
    "search_media": {
      "path": "/search/photos",
      "query": {
        "query": "{{ inputs.query }}",
        "page": "{{ inputs.page }}",
        "per_page": "{{ inputs.per_page }}"
      },
      "error_at": "/errors/0",
      "inputs": [
        "query",
        "page",
        "per_page"
      ]
    },
    "fetch_media": {
      "path": "/photos/{{ inputs.id }}/download",
      "result": {
        "file": {
          "file": {
            "from": "/url",
            "max_bytes": 10485760
          }
        }
      },
      "error_at": "/errors/0",
      "inputs": [
        "id"
      ]
    }
  },
  "meta": {
    "social": {
      "media_search": {
        "items_at": "/results",
        "id_at": "/id",
        "preview_at": "/urls/small",
        "url_at": "/urls/regular",
        "credit_at": "/user/name",
        "credit_link_at": "/user/links/html",
        "alt_at": "/alt_description",
        "width_at": "/width",
        "height_at": "/height",
        "licence": "Unsplash License: free to use; credit the photographer and Unsplash",
        "kind": "image"
      }
    },
    "note": "GET /photos/:id/download is the download Unsplash's guidelines ask to be triggered: fetch_media is it. Secret: access_key (the application's Access Key)."
  }
}
