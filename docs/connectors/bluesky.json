{
  "base": "https://bsky.social/xrpc",
  "auth": {
    "type": "session",
    "login": "create_session",
    "refresh": "refresh_session",
    "token_at": "/accessJwt",
    "refresh_at": "/refreshJwt"
  },
  "apps": [
    "social"
  ],
  "meta": {
    "carries": {
      "network": "Bluesky",
      "provider": "bluesky",
      "server": "service",
      "placeholder": "https://bsky.social"
    },
    "capabilities": {
      "name": "Bluesky",
      "max_text": 300,
      "images": true,
      "max_media": 4,
      "max_image_bytes": 2000000,
      "alt_text": true,
      "first_comment": false
    }
  },
  "operations": {
    "create_session": {
      "method": "POST",
      "path": "/com.atproto.server.createSession",
      "changes": false,
      "body": "{\"identifier\": {{ secret.handle | json }}, \"password\": {{ secret.app_password | json }}}",
      "error_at": "/message"
    },
    "refresh_session": {
      "method": "POST",
      "path": "/com.atproto.server.refreshSession",
      "body": "{}",
      "changes": false,
      "headers": {
        "authorization": "Bearer {{ inputs.refresh_token }}"
      },
      "error_at": "/message"
    },
    "publish": {
      "method": "POST",
      "path": "/com.atproto.repo.createRecord",
      "body": "{\"repo\": {{ secret.handle | json }}, \"collection\": \"app.bsky.feed.post\", \"record\": {\"$type\": \"app.bsky.feed.post\", \"text\": {% if inputs.link and not inputs.media_id %}{{ inputs.text | json }}{% else %}{{ inputs.text_with_link | json }}{% endif %}, \"createdAt\": {{ inputs.created_at | json }}{% if inputs.media_id %}, \"embed\": {\"$type\": \"app.bsky.embed.images\", \"images\": [{\"alt\": {{ inputs.alt | json }}, \"image\": {\"$type\": \"blob\", \"ref\": {\"$link\": {{ inputs.media_id | json }}}, \"mimeType\": {{ inputs.picture_type | json }}, \"size\": {{ inputs.picture_size | json }}}}]}{% elif inputs.link %}, \"embed\": {\"$type\": \"app.bsky.embed.external\", \"external\": {\"uri\": {{ inputs.link | json }}, \"title\": {{ inputs.link | json }}, \"description\": \"\"}}{% endif %}}}",
      "result": {
        "id": "/uri"
      },
      "error_at": "/message",
      "inputs": [
        "text",
        "link",
        "text_with_link",
        "media_id",
        "alt",
        "created_at",
        "picture_type",
        "picture_size"
      ]
    },
    "publish_media": {
      "method": "POST",
      "path": "/com.atproto.repo.uploadBlob",
      "body": {
        "file": "{{ inputs.file }}"
      },
      "result": {
        "id": "/blob/ref/$link"
      },
      "error_at": "/message",
      "inputs": [
        "file"
      ]
    },
    "delete": {
      "method": "POST",
      "path": "/com.atproto.repo.deleteRecord",
      "body": "{\"repo\": {{ secret.handle | json }}, \"collection\": \"app.bsky.feed.post\", \"rkey\": {{ inputs.id | split('/') | last | json }}}",
      "error_at": "/message",
      "inputs": [
        "id"
      ]
    },
    "reply": {
      "method": "POST",
      "path": "/com.atproto.repo.createRecord",
      "body": "{% set t = inputs.thread | split(' ') %}{\"repo\": {{ secret.handle | json }}, \"collection\": \"app.bsky.feed.post\", \"record\": {\"$type\": \"app.bsky.feed.post\", \"text\": {{ inputs.text | json }}, \"createdAt\": {{ inputs.created_at | json }}, \"reply\": {\"root\": {\"uri\": {{ t[0] | json }}, \"cid\": {{ t[1] | json }}}, \"parent\": {\"uri\": {{ inputs.in_reply_to | json }}, \"cid\": {{ t[2] | json }}}}}}",
      "result": {
        "id": "/uri"
      },
      "error_at": "/message",
      "inputs": [
        "text",
        "in_reply_to",
        "thread",
        "created_at"
      ]
    },
    "metrics": {
      "path": "/app.bsky.feed.getPosts",
      "query": {
        "uris": "{{ inputs.id }}"
      },
      "result": {
        "engagements": {
          "expr": "answer.posts[0].likeCount + answer.posts[0].repostCount + answer.posts[0].replyCount + answer.posts[0].quoteCount"
        }
      },
      "error_at": "/message",
      "inputs": [
        "id"
      ]
    },
    "account": {
      "path": "/app.bsky.actor.getProfile",
      "query": {
        "actor": "{{ secret.handle }}"
      },
      "result": {
        "followers": "/followersCount"
      },
      "error_at": "/message"
    },
    "messages": {
      "path": "/app.bsky.notification.listNotifications?reasons=reply&reasons=mention&reasons=quote",
      "query": {
        "limit": "50"
      },
      "error_at": "/message"
    }
  },
  "pulls": [
    {
      "name": "notifications",
      "operation": "messages",
      "every_minutes": 15,
      "items_at": "/notifications",
      "cursor": "time",
      "max_pages": 1,
      "map": {
        "entity": "SocialMessage",
        "outside": true,
        "by": {
          "external_id": "/uri"
        },
        "set": {
          "kind": "item.reason == 'reply' ? 'Comment' : 'Mention'",
          "author": "/author/handle",
          "author_id": "/author/did",
          "text": "/record/text",
          "post_external_id": "/reasonSubject",
          "thread": "has(item.record.reply) ? item.record.reply.root.uri + ' ' + item.record.reply.root.cid + ' ' + item.cid : item.uri + ' ' + item.cid + ' ' + item.cid",
          "via_connection": "connection.id"
        }
      }
    }
  ]
}
